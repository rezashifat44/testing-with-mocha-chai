# Copy this file to .env and fill in the two required values below.
#   cp .env.example .env

# ---- Required: you must provide these ----
baseUrl = "<API base URL, no trailing slash>"
X_AUTH_SECRET_KEY = "<secret key sent in the X-AUTH-SECRET-KEY header>"

